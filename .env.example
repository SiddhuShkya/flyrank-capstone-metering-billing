# Copy this file to .env and fill in the values.
# Do NOT commit .env to source control — it is in .gitignore.
#
# NOTE: This project runs entirely in Docker (docker compose up -d).
# DATABASE_URL is set automatically by docker-compose from the POSTGRES_* vars below.
# You do NOT need to set DATABASE_URL manually.

# --- Postgres (used by Docker Compose to create the database) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=billing
POSTGRES_PORT=5433

# --- Stripe test mode keys ---
# Get these from https://dashboard.stripe.com/test/apikeys (no credit card needed)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_test_price_id

# --- Stripe redirect URLs (default values work for local Docker) ---
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/cancel