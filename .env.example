# Copy this file to .env and fill in the values for your local environment.
# Do NOT commit .env to source control.

POSTGRES_USER=YOUR_POSTGRES_USERNAME
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_POSTGRES_DB_NAME
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# When running outside Docker, use localhost. When running inside Docker Compose, use the Postgres service host and internal port 5432.
DATABASE_URL=postgres://YOUR_POSTGRES_USERNAME:YOUR_POSTGRES_PASSWORD@localhost:5433/YOUR_POSTGRES_DB_NAME

# Stripe test mode values (optional until you integrate Stripe)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_test_price_id
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/cancel