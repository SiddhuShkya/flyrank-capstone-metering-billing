# Copy this file to .env and fill in the values for your local environment.
# Do NOT commit .env to source control.

POSTGRES_USER=YOUR_POSTGRES_USERNAME
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_POSTGRES_DB_NAME
POSTGRES_PORT=YOUR_POSTGRES_PORT # host port published by docker-compose
POSTGRES_HOST=YOUR_POSTGRES_HOST # service host for local or compose use

# When running inside Docker Compose, the app uses the Postgres service host and internal port 5432.
DATABASE_URL=postgres://YOUR_POSTGRES_USERNAME:YOUR_POSTGRES_PASSWORD@YOUR_POSTGRES_HOST:YOUR_POSTGRES_PORT/YOUR_POSTGRES_DB_NAME

# Stripe test mode values (optional until you integrate Stripe)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here